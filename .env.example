# Rutas
VACUINFO_PDF_DIR=pdf
VACUINFO_DATA_DIR=data
VACUINFO_MODELS_DIR=models

# Embeddings (FastEmbed / ONNX)
VACUINFO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Base vectorial
VACUINFO_CHROMA_COLLECTION=normativa_vacunacion

# Recuperación
VACUINFO_TOP_K=6
VACUINFO_VECTOR_K=10
VACUINFO_BM25_K=10

# LLM compatible con OpenAI (Ollama, OpenAI, etc.)
# Si se deja vacío, la API responde en modo extractivo con citas.
VACUINFO_LLM_BASE_URL=
VACUINFO_LLM_MODEL=qwen2.5:7b
VACUINFO_LLM_API_KEY=ollama
VACUINFO_LLM_TIMEOUT=60

# OCR local
VACUINFO_OCR_JOBS=4
