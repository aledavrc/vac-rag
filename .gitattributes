# Normaliza saltos de línea para que el repo funcione igual en Linux, macOS y Windows.
* text=auto eol=lf

# Scripts de shell: deben conservar LF (CRLF rompe `bash` en WSL/Git Bash).
*.sh text eol=lf
Makefile text eol=lf

# Scripts nativos de Windows (si se añaden más adelante).
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca normalizar ni tratar como texto.
*.pdf binary
*.onnx binary
*.bin binary
*.sqlite3 binary
*.traineddata binary
